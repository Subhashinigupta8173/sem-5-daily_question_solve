1class Solution {
2    public boolean isBipartite(int[][] graph) {
3        int n  = graph.length;
4        int [] color  = new int[n];
5        Arrays.fill(color,-1);
6        for(int i =0 ;i < n;i++){
7            if(color[i] != -1){
8                continue;
9            }
10            Queue<Integer> q = new LinkedList<>();
11            color[i] = 0;
12            q.offer(i);
13            while(!q.isEmpty()){
14                int node = q.poll();
15                for(int nbrs :  graph[node]){
16                    if(color[nbrs] == -1){
17                        color[nbrs] = 1 - color[node];
18                        q.offer(nbrs);
19                    }
20                    else if(color[nbrs] == color[node]){
21                        return false;
22                    }
23                }
24            }
25        }
26        return true;
27        
28    }
29}